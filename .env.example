# Required: Gmail inbox used by the agent
GMAIL_USER=your-account@gmail.com
GMAIL_APP_PASSWORD=your-16-character-app-password

# Required: Google Gemini API
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.6-flash

# Safety/runtime
DRAFT_ONLY_MODE=True
RUN_ONCE=True
POLL_INTERVAL=15

# Optional: HubSpot CRM
HUBSPOT_ACCESS_TOKEN=
HUBSPOT_PORTAL_ID=

# Optional: Salesforce CRM
SF_DOMAIN=https://login.salesforce.com
SF_CLIENT_ID=
SF_CLIENT_SECRET=
SF_USERNAME=
SF_PASSWORD=
SF_SECURITY_TOKEN=
